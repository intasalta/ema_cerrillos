<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Estación Meteorológica Automática INTA Cerrillos</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Feather Icons para iconografía moderna -->
  <script src="https://unpkg.com/feather-icons"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- HEADER INSTITUCIONAL -->
  <header class="bg-[#0B7BAF] text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center space-x-4">
        <img src="https://ema.inta.gob.ar/eeasalta_cerrillos/Logo_INTA.jpg" alt="Logo INTA" class="h-16 bg-white p-1 rounded-md shadow">
        <div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight">Estación Meteorológica Automática</h1>
          <p class="text-blue-100 text-sm font-medium">INTA CERRILLOS - SALTA</p>
        </div>
      </div>
      <div class="text-right text-xs sm:text-sm bg-blue-900/40 p-3 rounded-lg border border-blue-400/30">
        <p class="font-semibold text-blue-100"><i data-feather="map-pin" class="inline h-4 w-4 mr-1"></i> Lat 24° 53' 39" S | Long 65° 28' 15" O</p>
        <p class="text-blue-200">Altitud: 1235 msnm | Davis Vantage Pro 2</p>
      </div>
    </div>

    <!-- NAVBAR DE REPORTES -->
    <nav class="bg-blue-800/80 border-t border-blue-700/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-start overflow-x-auto py-2.5 text-xs sm:text-sm font-medium space-x-4 whitespace-nowrap scrollbar-none">
          <a href="https://ema.inta.gob.ar/" class="hover:text-blue-200 transition">Inicio</a>
          <span class="text-blue-400">|</span>
          <a href="downld02.txt" target="_blank" class="hover:text-blue-200 transition">Reporte 2 días</a>
          <span class="text-blue-400">|</span>
          <a href="downld08.txt" target="_blank" class="hover:text-blue-200 transition">Reporte 7 días</a>
          <span class="text-blue-400">|</span>
          <a href="NOAAMO.TXT" target="_blank" class="hover:text-blue-200 transition">Mensual</a>
          <span class="text-blue-400">|</span>
          <a href="NOAAPRMO.TXT" target="_blank" class="hover:text-blue-200 transition">Mes anterior</a>
          <span class="text-blue-400">|</span>
          <a href="NOAAYR.TXT" target="_blank" class="hover:text-blue-200 transition">Anual</a>
          <span class="text-blue-400">|</span>
          <a href="NOAAPRYR.TXT" target="_blank" class="hover:text-blue-200 transition">Año anterior</a>
          <span class="text-blue-400">|</span>
          <a href="https://docs.google.com/spreadsheets/d/e/2PACX-1vT7aA1iv_SP6XqV36w-hS8-TsIiBD2u4WlF0RFtgafbW9eIpOBKfZtBJczf_H_hx_jf6ZXLgVYDf5lf/pubhtml" target="_blank" class="text-amber-300 font-semibold hover:underline">Datos Históricos</a>
        </div>
      </div>
    </nav>
  </header>

  <!-- CONTENIDO PRINCIPAL / DASHBOARD -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full space-y-6">

    <!-- FECHA Y ESTADO DEL SOL -->
    <div class="bg-white rounded-xl shadow-sm p-4 md:p-6 border border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Última actualización</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-800 flex items-center gap-2">
          <i data-feather="clock" class="text-blue-500 h-5 w-5"></i>
          <!--StationDate--> - <!--StationTime-->
        </h2>
      </div>
      <div class="flex items-center gap-6 text-sm text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-100">
        <div class="flex items-center gap-2">
          <i data-feather="sunrise" class="text-amber-500"></i>
          <div>
            <p class="text-xs text-slate-400 font-medium">Salida Sol</p>
            <p class="font-semibold text-slate-700"><!--sunriseTime--> hs</p>
          </div>
        </div>
        <div class="h-8 w-px bg-slate-200"></div>
        <div class="flex items-center gap-2">
          <i data-feather="sunset" class="text-orange-500"></i>
          <div>
            <p class="text-xs text-slate-400 font-medium">Puesta Sol</p>
            <p class="font-semibold text-slate-700"><!--sunsetTime--> hs</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 1: TEMPERATURA, HUMEDAD Y SENSIBILIDAD -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- TARJETA: TEMPERATURA -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between">
        <div class="p-5">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-slate-700 flex items-center gap-2">
              <i data-feather="thermometer" class="text-red-500"></i> Temperatura
            </h3>
            <span class="text-3xl font-extrabold text-slate-900"><!--outsideTemp--><span class="text-lg font-medium text-slate-500"><!--tempUnit--></span></span>
          </div>

          <table class="w-full text-xs text-left text-slate-600">
            <thead class="bg-slate-50 text-slate-400 font-semibold uppercase">
              <tr>
                <th class="py-2 px-1">Período</th>
                <th class="py-2 px-1 text-center">Mínima</th>
                <th class="py-2 px-1 text-center">Máxima</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="py-2 font-medium">Diaria</td>
                <td class="py-2 text-center text-blue-600 font-semibold"><!--lowOutsideTemp--><!--tempUnit--></td>
                <td class="py-2 text-center text-red-600 font-semibold"><!--hiOutsideTemp--><!--tempUnit--></td>
              </tr>
              <tr class="text-[10px] text-slate-400">
                <td class="py-1">A hs:</td>
                <td class="py-1 text-center"><!--lowOutsideTempTime--></td>
                <td class="py-1 text-center"><!--hiOutsideTempTime--></td>
              </tr>
              <tr>
                <td class="py-2 font-medium">Mensual</td>
                <td class="py-2 text-center text-blue-600 font-semibold"><!--lowMonthlyOutsideTemp--><!--tempUnit--></td>
                <td class="py-2 text-center text-red-600 font-semibold"><!--hiMonthlyOutsideTemp--><!--tempUnit--></td>
              </tr>
              <tr>
                <td class="py-2 font-medium">Anual</td>
                <td class="py-2 text-center text-blue-600 font-semibold"><!--lowYearlyOutsideTemp--></td>
                <td class="py-2 text-center text-red-600 font-semibold"><!--hiYearlyOutsideTemp--></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="bg-slate-50 p-3 border-t border-slate-100 text-center">
          <img src="OutsideTempHistory.gif" alt="Gráfico Temperatura 24h" class="mx-auto max-h-36 rounded shadow-sm">
          <p class="text-[11px] text-slate-400 mt-2">Temperatura últimas 24 hs</p>
        </div>
      </div>

      <!-- TARJETA: HUMEDAD -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between">
        <div class="p-5">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-slate-700 flex items-center gap-2">
              <i data-feather="droplet" class="text-blue-500"></i> Humedad
            </h3>
            <span class="text-3xl font-extrabold text-slate-900"><!--outsideHumidity--><span class="text-lg font-medium text-slate-500"><!--humUnit--></span></span>
          </div>

          <table class="w-full text-xs text-left text-slate-600">
            <thead class="bg-slate-50 text-slate-400 font-semibold uppercase">
              <tr>
                <th class="py-2 px-1">Período</th>
                <th class="py-2 px-1 text-center">Mínima</th>
                <th class="py-2 px-1 text-center">Máxima</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="py-2 font-medium">Diaria</td>
                <td class="py-2 text-center font-semibold"><!--lowHumidity--><!--humUnit--></td>
                <td class="py-2 text-center font-semibold"><!--hiHumidity--><!--humUnit--></td>
              </tr>
              <tr class="text-[10px] text-slate-400">
                <td class="py-1">A hs:</td>
                <td class="py-1 text-center"><!--lowHumTime--></td>
                <td class="py-1 text-center"><!--hiHumTime--></td>
              </tr>
              <tr>
                <td class="py-2 font-medium">Mensual</td>
                <td class="py-2 text-center font-semibold"><!--lowMonthlyHumidity--><!--humUnit--></td>
                <td class="py-2 text-center font-semibold"><!--hiMonthlyHumidity--><!--humUnit--></td>
              </tr>
              <tr>
                <td class="py-2 font-medium">Anual</td>
                <td class="py-2 text-center font-semibold"><!--lowYearlyHumidity--><!--humUnit--></td>
                <td class="py-2 text-center font-semibold"><!--hiYearlyHumidity--><!--humUnit--></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="bg-slate-50 p-3 border-t border-slate-100 text-center">
          <img src="OutsideHumidityHistory.gif" alt="Gráfico Humedad 24h" class="mx-auto max-h-36 rounded shadow-sm">
          <p class="text-[11px] text-slate-400 mt-2">Humedad últimas 24 hs</p>
        </div>
      </div>

      <!-- TARJETA: SENSACIÓN TÉRMICA & CONFORT -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between">
        <div class="p-5 space-y-4">
          <h3 class="font-bold text-slate-700 flex items-center gap-2">
            <i data-feather="smile" class="text-emerald-500"></i> Sensación Térmica
          </h3>

          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 flex justify-between items-center">
            <div>
              <p class="text-xs text-slate-500 font-medium">Sensación por Viento</p>
              <p class="text-xs text-slate-400">Wind Chill</p>
            </div>
            <span class="text-2xl font-bold text-slate-800"><!--windChill--><!--tempUnit--></span>
          </div>

          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 flex justify-between items-center">
            <div>
              <p class="text-xs text-slate-500 font-medium">Índice de Calor</p>
              <p class="text-xs text-slate-400">Temp + Humedad</p>
            </div>
            <span class="text-2xl font-bold text-slate-800"><!--outsideHeatIndex--><!--tempUnit--></span>
          </div>

          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 flex justify-between items-center">
            <div>
              <p class="text-xs text-slate-500 font-medium">Punto de Rocío Actual</p>
            </div>
            <span class="text-xl font-bold text-slate-800"><!--outsideDewPt--><!--tempUnit--></span>
          </div>
        </div>

        <div class="bg-slate-50 p-3 border-t border-slate-100 text-center flex justify-center gap-2">
          <img src="WindChill.gif" alt="Gráfico WindChill" class="max-h-24 rounded shadow-sm">
          <img src="HeatIndex.gif" alt="Gráfico HeatIndex" class="max-h-24 rounded shadow-sm">
        </div>
      </div>

    </div>

    <!-- SECCIÓN 2: LLUVIA Y EVAPOTRANSPIRACIÓN -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- PRECIPITACIONES -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
        <h3 class="font-bold text-slate-700 flex items-center gap-2 mb-4">
          <i data-feather="cloud-rain" class="text-blue-600"></i> Precipitación & Lluvia
        </h3>

        <div class="grid grid-cols-2 gap-3 text-sm">
          <div class="bg-blue-50/60 p-3 rounded-lg">
            <p class="text-xs text-blue-600 font-medium">Lluvia del Día</p>
            <p class="text-xl font-bold text-blue-950"><!--dailyRain--> <!--rainUnit--></p>
          </div>

          <div class="bg-slate-50 p-3 rounded-lg">
            <p class="text-xs text-slate-500 font-medium">Intensidad Actual</p>
            <p class="text-xl font-bold text-slate-800"><!--rainRate--> <!--rateUnit--></p>
          </div>

          <div class="bg-slate-50 p-3 rounded-lg">
            <p class="text-xs text-slate-500 font-medium">Total Tormenta</p>
            <p class="text-lg font-bold text-slate-800"><!--stormRain--> <!--rainUnit--></p>
          </div>

          <div class="bg-slate-50 p-3 rounded-lg">
            <p class="text-xs text-slate-500 font-medium">Lluvia Mensual</p>
            <p class="text-lg font-bold text-slate-800"><!--monthlyRain--> <!--rainUnit--></p>
          </div>

          <div class="bg-slate-50 p-3 rounded-lg col-span-2">
            <p class="text-xs text-slate-500 font-medium">Acumulado Anual</p>
            <p class="text-xl font-bold text-slate-900"><!--totalRain--> <!--rainUnit--></p>
          </div>
        </div>
      </div>

      <!-- EVAPOTRANSPIRACIÓN & PUNTO ROCÍO HISTÓRICO -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-slate-700 flex items-center gap-2 mb-4">
            <i data-feather="sun" class="text-amber-500"></i> Evapotranspiración (ET)
          </h3>

          <div class="grid grid-cols-2 gap-3 text-sm mb-4">
            <div class="bg-amber-50/60 p-3 rounded-lg border border-amber-100">
              <p class="text-xs text-amber-700 font-medium">ET Diaria</p>
              <p class="text-xl font-bold text-amber-950"><!--dailyEt--> <!--rainUnit--></p>
            </div>
            <div class="bg-slate-50 p-3 rounded-lg">
              <p class="text-xs text-slate-500 font-medium">ET Mensual</p>
              <p class="text-xl font-bold text-slate-800"><!--monthlyEt--> <!--rainUnit--></p>
            </div>
          </div>
        </div>

        <div class="flex justify-around items-center pt-2 border-t border-slate-100">
          <div class="text-center">
            <img src="ETHistory.gif" alt="Gráfico ET" class="max-h-24 rounded shadow-sm mx-auto">
            <p class="text-[10px] text-slate-400 mt-1">Evapotranspiración</p>
          </div>
          <div class="text-center">
            <img src="DewPointHistory.gif" alt="Gráfico Punto Rocío" class="max-h-24 rounded shadow-sm mx-auto">
            <p class="text-[10px] text-slate-400 mt-1">Punto de Rocío 24h</p>
          </div>
        </div>
      </div>

    </div>

    <!-- SECCIÓN 3: VIENTO Y PRESIÓN BAROMÉTRICA -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- VIENTO -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
        <h3 class="font-bold text-slate-700 flex items-center gap-2 mb-4">
          <i data-feather="wind" class="text-sky-500"></i> Viento
        </h3>

        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="bg-slate-50 p-3 rounded-lg text-center">
            <p class="text-xs text-slate-400 font-medium">Velocidad Actual</p>
            <p class="text-2xl font-bold text-slate-800"><!--windSpeed--> <span class="text-xs font-normal text-slate-500"><!--windUnit--></span></p>
          </div>
          <div class="bg-slate-50 p-3 rounded-lg text-center">
            <p class="text-xs text-slate-400 font-medium">Dirección Sector</p>
            <p class="text-2xl font-bold text-blue-600"><!--windDirection--></p>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-3">
          <p class="text-xs font-semibold text-slate-400 uppercase mb-2">Máximas Registradas</p>
          <div class="grid grid-cols-3 gap-2 text-center text-xs">
            <div class="bg-slate-50 p-2 rounded">
              <span class="block text-slate-400">Diaria</span>
              <span class="font-bold text-slate-700"><!--HiwindSpeed--> <!--windUnit--></span>
            </div>
            <div class="bg-slate-50 p-2 rounded">
              <span class="block text-slate-400">Mensual</span>
              <span class="font-bold text-slate-700"><!--hiMonthlyWindSpeed--> <!--windUnit--></span>
            </div>
            <div class="bg-slate-50 p-2 rounded">
              <span class="block text-slate-400">Anual</span>
              <span class="font-bold text-slate-700"><!--hiYearlyWindSpeed--> <!--windUnit--></span>
            </div>
          </div>
        </div>

        <div class="flex justify-around items-center mt-4 pt-3 border-t border-slate-100">
          <img src="WindDirection.gif" alt="Dirección Viento" class="max-h-24">
          <img src="10MinAvgWindSpeed.gif" alt="Velocidad Media 10 min" class="max-h-24">
        </div>
      </div>

      <!-- PRESIÓN BAROMÉTRICA -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-slate-700 flex items-center gap-2 mb-4">
            <i data-feather="compass" class="text-indigo-500"></i> Presión Barométrica
          </h3>

          <div class="grid grid-cols-2 gap-3 text-sm mb-4">
            <div class="bg-slate-50 p-3 rounded-lg">
              <p class="text-xs text-slate-500 font-medium">Presión Actual</p>
              <p class="text-xl font-bold text-slate-900"><!--barometer--> <!--barUnit--></p>
            </div>
            <div class="bg-slate-50 p-3 rounded-lg">
              <p class="text-xs text-slate-500 font-medium">Tendencia (3 hs)</p>
              <p class="text-sm font-semibold text-indigo-600 mt-1"><!--barTrend--></p>
            </div>
          </div>

          <table class="w-full text-xs text-left text-slate-600 mb-4">
            <thead class="bg-slate-50 text-slate-400 font-semibold uppercase">
              <tr>
                <th class="py-2 px-1">Período</th>
                <th class="py-2 px-1 text-center">Mínima</th>
                <th class="py-2 px-1 text-center">Máxima</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="py-2 font-medium">Diaria</td>
                <td class="py-2 text-center font-semibold"><!--lowBarometer--> <!--barUnit--></td>
                <td class="py-2 text-center font-semibold"><!--hiBarometer--> <!--barUnit--></td>
              </tr>
              <tr class="text-[10px] text-slate-400">
                <td class="py-1">A hs:</td>
                <td class="py-1 text-center"><!--lowBarometerTime--></td>
                <td class="py-1 text-center"><!--hiBarometerTime--></td>
              </tr>
              <tr>
                <td class="py-2 font-medium">Mensual</td>
                <td class="py-2 text-center font-semibold"><!--lowMonthlyBarometer--> <!--barUnit--></td>
                <td class="py-2 text-center font-semibold"><!--hiMonthlyBarometer--> <!--barUnit--></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="text-center pt-2 border-t border-slate-100">
          <img src="BarometerHistory.gif" alt="Histórico Barómetro" class="mx-auto max-h-28 rounded shadow-sm">
        </div>
      </div>

    </div>

    <!-- ADVERTENCIA DE SERVICIO -->
    <div class="bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-xl text-xs flex items-center gap-3">
      <i data-feather="alert-circle" class="h-5 w-5 text-amber-600 shrink-0"></i>
      <p>Este servicio de datos online puede interrumpirse eventualmente por cortes de energía o caídas del enlace de red local.</p>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-slate-200 py-6 mt-6">
    <div class="max-w-7xl mx-auto px-4 text-center space-y-4">
      <div class="flex justify-center items-center gap-4">
        <a href="https://www.argentina.gob.ar/economia" target="_blank">
          <img src="https://ema.inta.gob.ar/eeasalta_cerrillos/logo_magyp.svg" alt="Secretaría de Agricultura, Ganadería y Pesca" class="h-10 opacity-80 hover:opacity-100 transition">
        </a>
      </div>
      <p class="text-xs text-slate-400">Ruta Nacional 68 Km 172, Cerrillos, Salta - Estación INTA Cerrillos</p>
    </div>
  </footer>

  <script>
    // Inicializar Iconos de Feather
    feather.replace();
  </script>
</body>
</html>